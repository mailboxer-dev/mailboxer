{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mailboxer",
  "main": "src/index.ts",
  "assets": {
    "directory": "./dist/ui"
  },
  "build": {
    "command": "npm run build:ui",
    "watch_dir": [
      "ui",
      "src",
      "vite.config.ts"
    ]
  },
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "secrets": {
    "required": [
      "MAIL_CREDENTIALS_ENCRYPTION_KEY"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    },
    {
      "binding": "MAIL_CREDENTIALS_KV"
    }
  ],
  "vars": {
    "CALDAV_URL": "https://caldav.icloud.com/",
    "CARDDAV_URL": "https://contacts.icloud.com/"
  }
}
