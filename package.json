{
  "name": "mailboxer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A stateless multi-account Email MCP server on Cloudflare Workers with an iCloud preset and custom IMAP/SMTP support.",
  "scripts": {
    "build:ui": "vite build",
    "dev:ui": "vite",
    "dev": "wrangler dev",
    "start": "npm run dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "cloudflare": {
    "bindings": {
      "OAUTH_KV": {
        "description": "OAuth sessions, tokens, and encrypted account details. Give this shared namespace a unique name such as `<worker-name>-oauth`."
      },
      "MAIL_CREDENTIALS_ENCRYPTION_KEY": {
        "description": "Encryption key for per-user account vaults. Generate with `openssl rand -hex 32`; do not reuse an email password."
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.20.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "postal-mime": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.0",
    "@eslint/js": "latest",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "latest",
    "tailwindcss": "^4.1.0",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "^7.3.0",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
